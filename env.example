# =============================================================================
# FluidTrack-Mini -- Configuration
# =============================================================================
# Copy this file to ".env":
#   Running from source (make run / make run-cli):  src/.env
#   Built app (make build):                         dist/FluidTrack-Mini/.env
#                                                   (next to the executable)
#
#   cp env.example src/.env
#
# The .env file contains credentials -- never commit or share it
# (it is already in .gitignore and is excluded by "make package").


# -----------------------------------------------------------------------------
# Local database (SQLite)
# -----------------------------------------------------------------------------
# Path to the database file. Leave empty = "FluidTrack.db" in the app folder
# (src/ or next to the executable). Relative paths are also resolved against
# the app folder, not the current working directory.
# Tip: to let the source run and the built app share the SAME database,
# set the same absolute path in both .env files.
DB_PATH=

# Table name -- used for the local SQLite table AND as the title of the
# table in Nextcloud Tables.
DB_TABLE_NAME=FuelTransactions


# -----------------------------------------------------------------------------
# Window language
# -----------------------------------------------------------------------------
# "de" = German, "en" = English. Leave empty = system language
# (German for any German locale, English otherwise). Log output stays English.
UI_LANGUAGE=


# -----------------------------------------------------------------------------
# Nextcloud Tables (OPTIONAL)
# -----------------------------------------------------------------------------
# Leave everything empty = local storage only, no cloud sync.
#
# Recommended: do NOT fill these in by hand -- use the browser login instead:
#   make login URL=https://cloud.example.com
#   or in the window: "Log in to Nextcloud..."
# This writes the URL, user, and a dedicated app password automatically.
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_APP_TOKEN=

# Determined automatically and saved here. The table is looked up by
# DB_TABLE_NAME and created (including its columns) if missing. If several
# tables with that name are visible (own ones and ones shared with you), the
# OLDEST writable one is used, so all users end up in the same table.
# Normally leave this empty.
NEXTCLOUD_TABLE_ID=

# Several users/installations, one table: share the table automatically.
# Comma-separated Nextcloud groups and/or users, e.g. "Fahrer" or
# "group:Fahrer, user:anna". They get read + create-rows permission only.
# Set this on the installation of the user who OWNS the table (usually the
# first one set up). The others then use the shared table automatically and
# upload their missing records into it. Empty = no automatic sharing.
NEXTCLOUD_SHARE_WITH=


# -----------------------------------------------------------------------------
# Erase the key after a successful sync
# -----------------------------------------------------------------------------
# true  = The key is erased automatically once EVERY transaction on it is
#         stored locally and -- if Nextcloud is configured -- confirmed
#         uploaded there. Without Nextcloud, local storage is sufficient.
#         Erasing works like the original PIUSI software: all record names are
#         blanked and the write index is reset, so the dispenser starts at slot
#         0 again. Firmware version and station number are preserved. The key
#         is read back afterwards to verify the result.
# false = The key is never modified (default).
#
# Can also be toggled with the checkbox in the window, which saves the value here.
#
# WARNING: Erased data cannot be recovered from the key.
# Test this with a non-critical key before using it in production!
DELETE_KEY_AFTER_SYNC=false
